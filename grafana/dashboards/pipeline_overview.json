{
  "__inputs": [],
  "__requires": [],
  "title": "Pipeline Overview",
  "uid": "pipeline-overview",
  "version": 1,
  "schemaVersion": 39,
  "tags": ["pipeline", "fm-analytics"],
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "refresh": "30s",
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "panels": [],
      "title": "Pipeline Health",
      "type": "row"
    },
    {
      "id": 2,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 1 },
      "type": "gauge",
      "title": "Success Rate",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(rate(pipeline_task_duration_seconds_count{status=\"completed\"}[$__rate_interval])) * 100 / sum(rate(pipeline_task_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "Success Rate"
        }
      ],
      "options": {
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "minVizHeight": 200,
        "minVizWidth": 200
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 90 },
              { "color": "green", "value": 99 }
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "type": "stat",
      "title": "Failed Tasks (1h)",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(pipeline_task_failures_total[1h]))",
          "legendFormat": "Failures"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        }
      }
    },
    {
      "id": 17,
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "type": "stat",
      "title": "Retries (1h)",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "sum(increase(pipeline_task_retries_total[1h]))",
          "legendFormat": "Retries"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 3 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "id": 18,
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 5 },
      "type": "stat",
      "title": "Error Breakdown by Task",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "topk(5, sum(increase(pipeline_task_failures_total[1h])) by (task_name))",
          "legendFormat": "{{ task_name }}"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": ["sum"],
          "fields": "/^.*$/"
        },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 3,
      "panels": [],
      "title": "Task Duration",
      "type": "row"
    },
    {
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "type": "timeseries",
      "title": "Duration p95 by Task",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(pipeline_task_duration_seconds_bucket[$__rate_interval])) by (le, task_name))",
          "legendFormat": "{{ task_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "type": "timeseries",
      "title": "Duration p99 by Task",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(pipeline_task_duration_seconds_bucket[$__rate_interval])) by (le, task_name))",
          "legendFormat": "{{ task_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 6,
      "panels": [],
      "title": "Rows Throughput",
      "type": "row"
    },
    {
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
      "type": "timeseries",
      "title": "Rows Processed",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(pipeline_rows_processed_total[$__rate_interval])",
          "legendFormat": "{{ layer }} / {{ snapshot_type }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
      "type": "timeseries",
      "title": "Rows Dropped",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(pipeline_rows_dropped_total[$__rate_interval])",
          "legendFormat": "{{ reason }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "id": 9,
      "panels": [],
      "title": "Errors & Retries",
      "type": "row"
    },
    {
      "id": 10,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "type": "timeseries",
      "title": "Error Rate by Type",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(pipeline_task_failures_total[$__rate_interval])",
          "legendFormat": "{{ error_type }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "type": "timeseries",
      "title": "Retry Rate",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "rate(pipeline_task_retries_total[$__rate_interval])",
          "legendFormat": "{{ task_name }}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": ["mean", "max", "last"]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 12,
      "panels": [],
      "title": "Recent Failures",
      "type": "row"
    },
    {
      "id": 13,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 37 },
      "type": "table",
      "title": "Recent Failures Details",
      "datasource": { "type": "prometheus" },
      "targets": [
        {
          "expr": "topk(20, pipeline_task_failures_total offset 5m - pipeline_task_failures_total)",
          "format": "table",
          "legendFormat": "",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": {}, "indexByName": { "Time": 0, "Value": 3, "__name__": 4, "error_type": 1, "instance": 4, "job": 4, "task_name": 2 } } }
      ],
      "options": {
        "sortBy": [
          { "displayName": "Value", "desc": true }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "left",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "custom.displayMode", "value": "color-background" },
              { "id": "color", "value": { "mode": "thresholds" } },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "red", "value": 1 }
                  ]
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
